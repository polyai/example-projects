          }
        }
      },
      "OMS_IDNV": {
        "steps": {
          "Collect billing postcode": {
            "is_enabled": false
          },
          "Collect billing zipcode": {
            "is_enabled": false
          },
          "Collect full order number": {
            "is_enabled": false
          },
          "Collect last 4": {
            "is_enabled": false
          },
          "Collect phone number": {
            "is_enabled": false
          }
        }
      },
      "SMS flow": {
        "steps": {
