{
  "asr": {
    "eager_final": true,
    "flow_overrides": {
      "LOYALTY_IDNV": {
        "steps": {
          "Verify loyalty number": {
            "model": "gpt-4o-transcribe",
            "provider": "openai"
          }
        }
      },
      "OMS_IDNV": {
        "steps": {
          "Collect billing postcode": {
            "model": "gpt-4o-transcribe",
            "provider": "openai"
          },
          "Collect billing zipcode": {
            "model": "gpt-4o-transcribe",
            "provider": "openai"
          },
          "Collect full order number": {
            "model": "gpt-4o-transcribe",
            "provider": "openai"
          },
          "Collect last 4": {
            "model": "gpt-4o-transcribe",
            "provider": "openai"
          },
          "Collect phone number": {
            "model": "gpt-4o-transcribe",
            "provider": "openai"
          }
        }
      },
      "SMS flow": {
        "steps": {
          "Phone number collected": {
            "model": "gpt-4o-transcribe",
            "provider": "openai"
          }
        }
      }
    },
    "language_overrides": {
      "fr-CA": {
        "model": "gpt-4o-transcribe",
        "provider": "openai"
      }
    },
    "model": "poly-latency",
    "provider": "default",
    "use_asr_lib": true
