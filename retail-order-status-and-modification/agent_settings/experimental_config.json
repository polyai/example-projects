          "Collect phone number": {
            "threshold": 0.7,
            "timeout_ms": 1200
          }
        }
      },
      "SMS flow": {
        "steps": {
          "Phone number collected": {
            "threshold": 0.7,
            "timeout_ms": 1200
          }
        }
      }
    },
    "provider": "smart_turn"
  },
  "filler_utterances": {
    "interval_sec": 3,
    "is_enabled": true,
    "utterances": {
      "en-US": [
        "One moment",
        "Just a second",
        "almost there"
      ],
      "fr-CA": [
        "Un instant",
        "Juste un moment",
        "Une seconde"
      ]
    }
  },
  "llm": {
    "flow_overrides": {
      "OMS_WISMO": {
        "inference_parameters": {
          "reasoning_effort": "low"
        }
      }
    }
  },
  "memory": {
    "repeat_caller": {
      "analytics_enabled": true,
      "state_keys": [
        "zd_requester_id"
      ]
    }
  },
  "prompts": {
    "silence": "The user is silent."
