{
  "asr": {
    "eager_final": true,
    "flow_overrides": {
      "sms_flow": {
        "steps": {
          "Send Link": {
            "eager_final": false
          }
        }
      },
      "verify_caller": {
        "steps": {
          "Verify Caller": {
            "eager_final": false
          }
        }
      }
    },
    "model": "poly-latency",
    "provider": "default",
    "use_asr_lib": true
  },
  "barge_in": {
    "flow_overrides": {
      "sms_flow": {
        "steps": {
          "Send Link": {
            "is_enabled": false
          }
        }
      },
      "verify_caller": {
        "steps": {
          "Verify Caller": {
            "is_enabled": false
          }
        }
      }
    },
    "is_enabled": true
  },
  "conversation_control": {
    "max_silence_count": 20
  },
  "eot": {
    "flow_overrides": {
      "sms_flow": {
        "steps": {
          "Send Link": {
            "threshold": 0.6,
            "timeout_ms": 2000
          }
        }
      },
      "verify_caller": {
        "steps": {
          "Verify Caller": {
            "threshold": 0.6,
            "timeout_ms": 2000
          }
        }
      }
    },
    "provider": "smart_turn",
    "threshold": 0.5,
    "timeout_ms": 500
  },
  "filler_utterances": {
    "interval_sec": 3,
    "is_enabled": true,
    "randomize": false,
    "utterances": [
      "One moment...",
      "Just a second..."
    ]
  },
  "llm": {
    "flow_overrides": {
      "track_order": {
        "inference_parameters": {
          "reasoning_effort": "low"
        }
      }
    }
  },
  "prompts": {
    "silence": "The user is silent.",
    "step_footer": "Answer any question the caller asks before carrying on.\nUse what the caller has already told you; never ask for it again.\nIf the caller needs time to find something, call the wait function and stay quiet until they speak.\n\nBe conversational and brief."
  },
  "ragdoll": {
    "feature_flags": {
      "azure_search": true
    }
  },
  "smart_vad": {
    "flow_overrides": {
      "sms_flow": {
        "steps": {
          "Send Link": {
            "is_enabled": false
          }
        }
      },
      "verify_caller": {
        "steps": {
          "Verify Caller": {
            "is_enabled": false
          }
        }
      }
    },
    "is_enabled": true,
    "max_extension_duration": "1s",
    "max_extensions": 5
  },
  "vad": {
    "flow_overrides": {
      "sms_flow": {
        "steps": {
          "Send Link": {
            "vad_end": 1600
          }
        }
      },
      "verify_caller": {
        "steps": {
          "Verify Caller": {
            "vad_end": 1600
          }
        }
      }
    },
    "provider": "silero",
    "vad_end": 800
  }
}
