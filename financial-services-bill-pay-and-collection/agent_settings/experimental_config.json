{
  "asr": {
    "eager_final": true,
    "flow_overrides": {
      "Greet User": {
        "steps": {
          "Greet User": {
            "hard_timeout": 0.1,
            "initial_timeout": 0.1
          }
        }
      }
    },
    "initial_timeout": 6,
    "inter_response_timeout": 4,
    "language": "en-US",
    "model": "poly-latency",
    "provider": "default",
    "use_asr_lib": true
  },
  "audio_enhancement": {
    "ai-coustics": {
      "enabled": true,
      "model": "standard",
      "noise_gate": true,
      "noise_reduction": 0.9,
      "voice_gain": 1.3
    }
  },
  "barge_in": {
    "is_enabled": false
  },
  "conversation_control": {
    "max_silence_count": 30
  },
  "filler_utterances": {
    "interval_sec": 3,
    "is_enabled": true,
    "randomize": true,
    "utterances": [
      "Right...",
      "Mhm...",
      "Mhmm...",
      "Uh-huh..."
    ]
  },
  "handoff_api": {
    "state_keys": [
      "handoff_reason_summary"
    ]
  },
  "llm": {
    "channel_overrides": {
      "webchat.polyai": {
        "provider_model_id": "azure-oai-gpt-4o"
      }
    },
    "include_kb_functions_in_flows": true
  },
  "memory": {
    "repeat_caller": {
      "analytics_enabled": true,
      "identifier_blacklist": []
    }
  },
  "prompts": {
    "silence": "The user is silent.",
    "webchat_decorator": "IMPORTANT: You're actually conducting this conversation via webchat rather than over the phone. This means several things. Firstly, you're strongly encouraged to use bulletpoints, lists etc. Secondly, you should not offer to send text messages to users. Adapt your style and formatting to be appropriate for a webchat conversation."
  },
  "ragdoll": {
    "history_len": 10,
    "previous_user_inputs_len": 1,
    "top_k": 4
  },
  "smart_vad": {
    "is_enabled": true,
    "max_extension_duration": "1.5s",
    "max_extensions": 7
  },
  "vad": {
    "flow_overrides": {
      "SMS flow": {
        "steps": {
          "Collect Alternative Phone Number": {
            "vad_end": 1000
          }
        }
      }
    },
    "provider": "silero",
    "vad_end": 600
  }
}
