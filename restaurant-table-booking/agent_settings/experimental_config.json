{
  "asr": {
    "disable_itn": true,
    "disable_punctuation": true,
    "eager_final": true,
    "flow_overrides": {
      "sms_flow": {
        "steps": {
          "Send Text": {
            "eager_final": false
          }
        }
      },
      "verify_caller": {
        "steps": {
          "Verify Caller": {
            "eager_final": false
          }
        }
      }
    },
    "model": "poly-latency",
    "provider": "default",
    "use_asr_lib": true
  },
  "background_track": {
    "loudness": -50,
    "name": "restaurant-ambiance"
  },
  "barge_in": {
    "flow_overrides": {
      "sms_flow": {
        "steps": {
          "Send Text": {
            "is_enabled": false
          }
        }
      },
      "verify_caller": {
        "steps": {
          "Verify Caller": {
            "is_enabled": false
          }
        }
      }
    },
    "is_enabled": true,
    "trigger": {
      "speech_threshold": 0.6,
      "speech_window_ms": 100
    }
  },
  "conversation_control": {
    "max_silence_count": 3
  },
  "eot": {
    "flow_overrides": {
      "sms_flow": {
        "steps": {
          "Send Text": {
            "threshold": 0.6,
            "timeout_ms": 2000
          }
        }
      },
      "verify_caller": {
        "steps": {
          "Verify Caller": {
            "threshold": 0.6,
            "timeout_ms": 2000
          }
        }
      }
    },
    "provider": "smart_turn",
    "threshold": 0.5,
    "timeout_ms": 500
  },
  "llm": {
    "include_kb_functions_in_flows": true
  },
  "prompts": {
    "context_information_precursor": "Your TASK is to answer questions and perform certain actions based on the CONTEXT_INFORMATION list below.\nEach entry consists of \"faq_id\", \"faq_example_questions\", \"faq_description\", and \"faq_instructions\":\n- You must always follow the instructions in \"faq_instructions\".\n- You can only answer questions with reference to the information in \"faq_description\".\n- If the user's query is unclear, ask for clarification.",
    "silence": "The user is silent.",
    "step_footer": "Answer any question the caller asks before carrying on.\nUse what the caller has already told you; never ask for it again.\nIf the caller needs time to find something, call the wait function and stay quiet until they speak.\n\nBe conversational and brief."
  },
  "ragdoll": {
    "top_k": 7
  },
  "smart_vad": {
    "gated_functions": {
      "": [
        "finalize_booking",
        "modify_booking",
        "cancel_booking"
      ]
    }
  },
  "vad": {
    "flow_overrides": {
      "sms_flow": {
        "steps": {
          "Send Text": {
            "vad_end": 1600
          }
        }
      },
      "verify_caller": {
        "steps": {
          "Verify Caller": {
            "vad_end": 1600
          }
        }
      }
    }
  }
}
